@model IEnumerable<JREST.Models.Notification>
@{
    ViewData["Title"] = "إشعارات الطالبة";
    Layout = "_HeaderAndFooter";
}

<div class="container my-5" style="max-width: 900px; direction: rtl; text-align: right;">

    <!-- عنوان الصفحة مع الأيقونة -->
    <div class="d-flex align-items-center justify-content-center mb-4">
        <h3 class="text-custom-blue fw-bold mb-0">
            <i class="bi bi-bell-fill ms-2"></i> إشعارات الطالبة
        </h3>
    </div>

    <!-- جدول الإشعارات -->
    <div class="card shadow-sm border-0 rounded-4 bg-white p-4">
        <div class="table-responsive">
            <table class="table table-bordered align-middle mb-0 text-center" id="notificationsTable">
                <thead class="table-light">
                    <tr>
                        <th class="py-3 text-custom-blue" style="width: 15%;">رقم الإشعار</th>
                        <th class="py-3 text-custom-blue" style="width: 50%;">الوصف </th>
                        <th class="py-3 text-custom-blue" style="width: 35%;">الوقت </th>
                    </tr>
                </thead>
                <tbody id="notificationsTbody">
                    @if (Model != null && Model.Any())
                    {
                        int index = 1;
                        foreach (var item in Model)
                        {
                            bool isHeadMessage = item.Message != null && item.Message.StartsWith("تم إرسال رسالة من رئيس الشعبة:");

                            <tr class="notification-row">
                                <td class="fw-bold text-secondary">@index</td>
                                <td class="text-end px-3 lh-base">
                                    @if (isHeadMessage)
                                    {
                                        string fullMessage = item.Message ?? "";
                                        string shortMessage = fullMessage.Length > 50 ? fullMessage.Substring(0, 50) + "..." : fullMessage;

                                        <div class="clickable-msg p-1 rounded"
                                             style="cursor: pointer;"
                                             data-fullmessage="@fullMessage"
                                             onclick="showFullNotificationMessage(this)"
                                             title="انقر لعرض الرسالة كاملاً">
                                            <span class="fw-bold text-custom-blue"><i class="bi bi-envelope-fill ms-1"></i> تم إرسال رسالة من رئيس الشعبة:</span>
                                            <span class="text-dark">@(fullMessage.Replace("تم إرسال رسالة من رئيس الشعبة:", "").Trim())</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span>@item.Message</span>
                                    }
                                </td>
                                <td class="text-muted small dir-ltr">@item.CreatedAt.ToString("yyyy/MM/dd hh:mm tt")</td>
                            </tr>
                            index++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted py-5">
                                <i class="bi bi-bell-slash fs-2 mb-2 d-block text-secondary"></i>
                                لا توجد إشعارات جديدة حالياً.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- الباجنيشن (Pagination) -->
        @if (Model != null && Model.Any())
        {
            <div class="d-flex justify-content-start align-items-center mt-4 pt-2">
                <nav aria-label="Page navigation">
                    <ul class="pagination mb-0 gap-1" id="paginationNav">
                        <li class="page-item" id="prevPage">
                            <a class="page-link rounded-3 text-custom-blue" href="javascript:void(0);">السابق</a>
                        </li>
                        <li class="page-item" id="pageNumbersContainer" style="display: flex; gap: 4px;"></li>
                        <li class="page-item" id="nextPage">
                            <a class="page-link rounded-3 text-custom-blue" href="javascript:void(0);">التالي</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<!-- Modal النافذة المنبثقة لعرض نص الرسالة كاملاً -->
<div class="modal fade" id="msgModal" tabindex="-1" aria-labelledby="msgModalLabel" aria-hidden="true" dir="rtl">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header bg-light rounded-top-4 border-0">
                <h5 class="modal-header-title text-custom-blue fw-bold mb-0" id="msgModalLabel">
                    <i class="bi bi-chat-left-text-fill ms-2"></i> رسالة من رئيس الشعبة
                </h5>
                <button type="button" class="btn-close ms-0 me-auto" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 fs-6 text-dark lh-lg" id="modalMsgBody">
                <!-- ينزل هنا نص الرسالة -->
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">إغلاق</button>
            </div>
        </div>
    </div>
</div>

<script>
    // دالة عرض النافذة المنبثقة للرسائل الكاملة بأمان تام
    function showFullNotificationMessage(element) {
        var message = element.getAttribute("data-fullmessage");
        document.getElementById("modalMsgBodyinnerText" || "modalMsgBody").innerText = message;
        var myModal = new bootstrap.Modal(document.getElementById('msgModal'));
        myModal.show();
    }

    document.addEventListener("DOMContentLoaded", function () {
        const rowsPerPage = 5;
        const rows = document.querySelectorAll(".notification-row");
        const totalPages = Math.ceil(rows.length / rowsPerPage);

        if (rows.length === 0) return;

        let currentPage = 1;

        function displayPage(page) {
            currentPage = page;
            const start = (page - 1) * rowsPerPage;
            const end = start + rowsPerPage;

            rows.forEach((row, index) => {
                if (index >= start && index < end) {
                    row.style.display = "";
                } else {
                    row.style.display = "none";
                }
            });

            updatePagination();
        }

        function updatePagination() {
            const container = document.getElementById("pageNumbersContainer");
            const prevBtn = document.getElementById("prevPage");
            const nextBtn = document.getElementById("nextPage");

            container.innerHTML = "";

            for (let i = 1; i <= totalPages; i++) {
                const li = document.createElement("li");
                li.className = `page-item ${i === currentPage ? "active" : ""}`;

                const a = document.createElement("a");
                a.className = `page-link rounded-3 ${i === currentPage ? "bg-custom-blue border-custom-blue text-white" : "text-custom-blue"}`;
                a.href = "javascript:void(0);";
                a.innerText = i;
                a.addEventListener("click", () => displayPage(i));

                li.appendChild(a);
                container.appendChild(li);
            }

            if (currentPage === 1) {
                prevBtn.classList.add("disabled");
            } else {
                prevBtn.classList.remove("disabled");
            }

            if (currentPage === totalPages || totalPages === 0) {
                nextBtn.classList.add("disabled");
            } else {
                nextBtn.classList.remove("disabled");
            }
        }

        document.getElementById("prevPage").addEventListener("click", function () {
            if (currentPage > 1) displayPage(currentPage - 1);
        });

        document.getElementById("nextPage").addEventListener("click", function () {
            if (currentPage < totalPages) displayPage(currentPage + 1);
        });

        displayPage(1);
    });
</script>

<style>
    .bg-custom-blue {
        background-color: #2666AE !important;
    }

    .border-custom-blue {
        border-color: #2666AE !important;
    }

    .text-custom-blue {
        color: #2666AE !important;
    }

    .clickable-msg:hover {
        background-color: #f1f5f9;
        transition: background-color 0.2s ease;
    }

    .page-link {
        border-radius: 6px !important;
        font-weight: 600;
        cursor: pointer;
    }

    .dir-ltr {
        direction: ltr;
    }
</style>