@{
    ViewData["Title"] = "إشعارات العميد";
    Layout = "_HeaderAndFooter";
}

<div class="container my-5" style="max-width: 950px; direction: rtl; text-align: right;">

    <!-- عنوان الصفحة مع الأيقونة -->
    <div class="d-flex align-items-center justify-content-center mb-5">
        <h3 class="text-custom-blue fw-bold mb-0">
            <i class="fas fa-bell ms-2"></i> إشعارات العميد
        </h3>
    </div>

    <!-- جدول الإشعارات -->
    <div class="card shadow-sm border-0 rounded-4 bg-white p-3">
        <div class="table-responsive">
            <table class="table table-bordered text-center align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="py-3 text-custom-blue" style="width: 15%;">رقم الإشعار</th>
                        <th class="py-3 text-custom-blue" style="width: 45%;">الوصف</th>
                        <th class="py-3 text-custom-blue" style="width: 20%;">الوقت</th>
                        <th class="py-3 text-custom-blue" style="width: 20%;">الإجراء</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- سيتم جلب البيانات لاحقاً من قاعدة البيانات الحقيقية -->
                    <tr>
                        <td colspan="4" class="text-muted py-4">لا توجد إشعارات جديدة حالياً.</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- الباجنيشن بنفس التنسيق المطلوب (السابق، 1، التالي) -->
        <div class="d-flex justify-content-end mt-4">
            <nav aria-label="Page navigation">
                <ul class="pagination mb-0">
                    <li class="page-item"><a class="page-link text-secondary" href="#">السابق</a></li>
                    <li class="page-item active"><a class="page-link bg-custom-blue border-custom-blue text-white" href="#">1</a></li>
                    <li class="page-item"><a class="page-link text-secondary" href="#">التالي</a></li>
                </ul>
            </nav>
        </div>

    </div>
</div>

<style>
    .bg-custom-blue {
        background-color: #2666AE !important;
    }

    .border-custom-blue {
        border-color: #2666AE !important;
    }
</style>