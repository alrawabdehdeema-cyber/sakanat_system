        <h5 class="text-custom-blue fw-bold mb-3 border-bottom pb-2">المعلومات الأكاديمية والشخصية</h5>
        <div class="row g-3">
            <div class="col-md-4">
                <label class="text-muted small">الرقم الجامعي:</label>
                <p class="fw-semibold mb-0">2023123456</p>
            </div>
            <div class="col-md-8">
                <label class="text-muted small">الاسم من اربعة مقاطع:</label>
                <p class="fw-semibold mb-0">ساره مهند أحمد محمد</p>
            </div>
            <div class="col-md-4">
                <label class="text-muted small">التخصص الجامعي:</label>
                <p class="fw-semibold mb-0">هندسة البرمجيات</p>
            </div>
            <div class="col-md-4">
                <label class="text-muted small">المعدل التراكمي:</label>
                <p class="fw-semibold mb-0">3.65</p>
            </div>
            <div class="col-md-4">
                <label class="text-muted small">معدل الثانوية العامة:</label>
                <p class="fw-semibold mb-0">92.4</p>
            </div>
            <div class="col-md-4">
                <label class="text-muted small">تاريخ الالتحاق اول مره:</label>
                <p class="fw-semibold mb-0">2023/09/15</p>
            </div>
            <div class="col-md-4">
                <label class="text-muted small">رقم موبايل الطالبة:</label>
                <p class="fw-semibold mb-0">0791234567</p>
            </div>
            <div class="col-md-4">
                <label class="text-muted small">رقم موبايل ولي الامر:</label>
                <p class="fw-semibold mb-0">0789876543</p>
            </div>
            <div class="col-md-4">
                <label class="text-muted small">رقم جواز السفر:</label>
                <p class="fw-semibold mb-0">A1234567</p>
            </div>
            <div class="col-md-3">
                <label class="text-muted small">الحالة الاجتماعية:</label>
                <p class="fw-semibold mb-0">عزباء</p>
            </div>
            <div class="col-md-3">
                <label class="text-muted small">الديانة:</label>
                <p class="fw-semibold mb-0">مسلمة</p>
            </div>
            <div class="col-md-3">
                <label class="text-muted small">الجنسية:</label>
                <p class="fw-semibold mb-0">أردنية</p>
            </div>
            <div class="col-md-3">
                <label class="text-muted small">تاريخ الميلاد:</label>
                <p class="fw-semibold mb-0">2005/05/10</p>
            </div>
            <div class="col-md-4">
                <label class="text-muted small">العام الدراسي:</label>
                <p class="fw-semibold mb-0">2025/2026</p>
            </div>
            <div class="col-md-4">
                <label class="text-muted small">المستوى الدراسي:</label>
                <p class="fw-semibold mb-0">السنة الثالثة</p>
            </div>
            <div class="col-md-4">
                <label class="text-muted small">نوع الدراسة:</label>
                <p class="fw-semibold mb-0">انتظام</p>
            </div>
            <div class="col-md-4">
                <label class="text-muted small">اسم السكن:</label>
                <p class="fw-semibold mb-0">سكن طالبات الجامعة</p>
            </div>
            <div class="col-md-4">
                <label class="text-muted small">الكلية:</label>
                <p class="fw-semibold mb-0">تكنولوجيا المعلومات</p>
            </div>
            <div class="col-md-4">
                <label class="text-muted small">العقوبات:</label>
                <p class="fw-semibold mb-0 text-success">لا يوجد</p>
            </div>
            <div class="col-md-6">
                <label class="text-muted small">ولي أمر الطالبة (أتحمل المسؤولية القانونية أمام ادارة):</label>
                <p class="fw-semibold mb-0">مهند أحمد محمد</p>
            </div>
            <div class="col-md-6">
                <label class="text-muted small">الجامعة في حال اي نقص أنا:</label>
                <p class="fw-semibold mb-0">مهند أحمد محمد</p>
            </div>
        </div>
    </div>

    <!-- 2. العنوان السكني الدائم لعائلة الطالبة -->
    <div class="card shadow-sm border-0 rounded-4 mb-4 p-4 bg-white">
        <h5 class="text-custom-blue fw-bold mb-3 border-bottom pb-2">العنوان السكني الدائم لعائلة الطالبة</h5>
        <div class="row g-3">
            <div class="col-md-12">
                <label class="text-muted small">العنوان السكني الدائم لعائلة الطالبة:</label>
                <p class="fw-semibold mb-0">إربد - صما - الشارع الرئيسي</p>
            </div>
            <div class="col-md-4">
                <label class="text-muted small">المحافظة:</label>
                <p class="fw-semibold mb-0">إربد</p>
            </div>
            <div class="col-md-4">
                <label class="text-muted small">طبيعة السكن:</label>
                <p class="fw-semibold mb-0">ملك</p>
            </div>
            <div class="col-md-4">
                <label class="text-muted small">المدينة:</label>
                <p class="fw-semibold mb-0">إربد</p>
            </div>
            <div class="col-md-4">
                <label class="text-muted small">رقم المبنى:</label>
                <p class="fw-semibold mb-0">12</p>
            </div>
            <div class="col-md-4">
                <label class="text-muted small">الشارع:</label>
                <p class="fw-semibold mb-0">شارع الملك حسين</p>
            </div>
            <div class="col-md-4">
                <label class="text-muted small">الحي:</label>
                <p class="fw-semibold mb-0">حي النزهة</p>
            </div>
        </div>
    </div>

    <!-- 3. المعلومات الصحية وبيانات التواصل في حالة الطوارئ -->
    <div class="card shadow-sm border-0 rounded-4 mb-4 p-4 bg-white">
        <h5 class="text-custom-blue fw-bold mb-3 border-bottom pb-2">المعلومات الصحية تفاصيل المعلومات الصحية وبيانات التواصل والتأمين الصحي في حالة الطوارئ</h5>
        <div class="row g-3">
            <div class="col-md-4">
                <label class="text-muted small">اسم للتواصل معه في حالة الطوارئ:</label>
                <p class="fw-semibold mb-0">أحمد محمد</p>
            </div>
            <div class="col-md-4">
                <label class="text-muted small">رقم هاتفه:</label>
                <p class="fw-semibold mb-0">0771122334</p>
            </div>
            <div class="col-md-4">
                <label class="text-muted small">نوع العلاقة:</label>
                <p class="fw-semibold mb-0">عم</p>
            </div>
            <div class="col-md-6">
                <label class="text-muted small">هل لديك تأمين صحي؟</label>
                <p class="fw-semibold mb-0">نعم</p>
            </div>
            <div class="col-md-6">
                <label class="text-muted small">هل تحتاج الى اي نوع من الرعاية الصحية وهل لديك امراض؟</label>
                <p class="fw-semibold mb-0">لا أحتاج الى رعاية صحية</p>
            </div>
            <div class="col-md-12">
                <label class="text-muted small">الحالات الصحية التفصيلية:</label>
                <ul class="mb-0 ps-3">
                    <li>اعاني من حساسية وتفصيلها: لا يوجد</li>
                    <li>اعاني من اعاقة جسدية وتفصيلها: لا يوجد</li>
                    <li>أحتاج الى دواء محدد وتفصيله: لا يوجد</li>
                </ul>
            </div>
            <div class="col-md-12 mt-3">
                <label class="text-muted small">الأمراض التي تم اختيارها (إن وجدت):</label>
                <p class="fw-semibold mb-0 text-success">لا توجد أمراض مزمنة محددة</p>
            </div>
        </div>
    </div>

    <!-- 4. صلاحيات المغادرة والسفر -->
    <div class="card shadow-sm border-0 rounded-4 mb-4 p-4 bg-white">
        <h5 class="text-custom-blue fw-bold mb-3 border-bottom pb-2">صلاحيات المغادرة والسفر</h5>
        <div class="row g-3">
            <div class="col-md-12">
                <ul class="list-unstyled mb-0">
                    <li><i class="fas fa-check text-success ms-2"></i> السماح للطالبة بمغادرة السكن لقضاء عطلة نهاية الاسبوع والأعياد الرسمية بمفردها وعند الأشخاص المذكورين اعلاه فقط</li>
                    <li><i class="fas fa-check text-success ms-2"></i> السماح للطالبة بالمشاركة بالرحلات الداخلية لمدة يوم</li>
                    <li><i class="fas fa-times text-danger ms-2"></i> السماح للطالبة بالمشاركة بالرحلات الداخلية لأكثر من يوم</li>
                    <li><i class="fas fa-times text-danger ms-2"></i> السماح للطالبة بالسفر خارج البلاد بمفردها (للاشخاص القاطنين خارج الأردن)</li>
                </ul>
            </div>
        </div>
    </div>

    <!-- 5. الوثائق والمرفقات -->
    <div class="card shadow-sm border-0 rounded-4 mb-4 p-4 bg-white">
        <h5 class="text-custom-blue fw-bold mb-3 border-bottom pb-2">يرجى تحميل الوثائق التالية</h5>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="text-muted small">صورة واضحة ملونة عن شهادة خلو الأمراض:</label>
                <p class="fw-semibold mb-0"><span class="badge bg-secondary">Medical_Report.pdf</span></p>
            </div>
            <div class="col-md-6">
                <label class="text-muted small">صورة واضحة عن دفتر العائلة:</label>
                <p class="fw-semibold mb-0"><span class="badge bg-secondary">Family_Book.pdf</span></p>
            </div>
            <div class="col-md-6">
                <label class="text-muted small">صورة واضحة عن كتاب التوكيل\الكفالة الرسمية في حال تغيير الوكيل فقط:</label>
                <p class="fw-semibold mb-0"><span class="badge bg-secondary">غير مطلوب / لم يتم الإرفاق</span></p>
            </div>
            <div class="col-md-6">
                <label class="text-muted small">صورة واضحة ملونة عن هوية الأحوال المدنية للوكيل أو الصفحة الأولى لجواز السفر:</label>
                <p class="fw-semibold mb-0"><span class="badge bg-secondary">Agent_ID.pdf</span></p>
            </div>
        </div>
    </div>

    <!-- أزرار اتخاذ القرار (قبول / رفض) -->
    <div class="d-flex justify-content-end gap-3 mt-4 mb-5">
        <a asp-controller="Home" asp-action="confirm_acceptance" class="btn btn-success px-4 py-2">
            <i class="fas fa-check ms-1"></i> قبول الطلب
        </a>
        <a asp-controller="Home" asp-action="confirm_rejection" class="btn btn-danger px-4 py-2">
            <i class="fas fa-times ms-1"></i> رفض الطلب
        </a>
    </div>

</div>

<style>
    .text-custom-blue {
        color: #2666AE !important;
    }
</style>