@{
    ViewData["Title"] = "طلب إلحاق الطالب بالسكن - الخطوة 6";
    Layout = "_HeaderAndFooter";
}

<div class="container my-5" dir="rtl">

    <!-- عنوان الصفحة -->
    <h3 class="text-custom-blue fw-bold mb-4 text-end">طلب إلحاق الطالب بالسكن</h3>

    <!-- شريط الخطوات (Stepper) يدعم القفز الحر والتحديد التلقائي -->
    <div class="stepper-container mb-5">
        <div class="d-flex align-items-center gap-2">
            <!-- الخطوة 1 -->
            <a href="@Url.Action("housing_form", "Home")" class="step-circle text-decoration-none @(ViewContext.RouteData.Values["action"]?.ToString() == "housing_form" ? "active" : "")">1</a>
            <div class="step-line"></div>

            <!-- الخطوة 2 -->
            <a href="@Url.Action("housing_form_step2", "Home")" class="step-circle text-decoration-none @(ViewContext.RouteData.Values["action"]?.ToString() == "housing_form_step2" ? "active" : "")">2</a>
            <div class="step-line"></div>

            <!-- الخطوة 3 -->
            <a href="@Url.Action("housing_form_step3", "Home")" class="step-circle text-decoration-none @(ViewContext.RouteData.Values["action"]?.ToString() == "housing_form_step3" ? "active" : "")">3</a>
            <div class="step-line"></div>

            <!-- الخطوة 4 -->
            <a href="@Url.Action("housing_form_step4", "Home")" class="step-circle text-decoration-none @(ViewContext.RouteData.Values["action"]?.ToString() == "housing_form_step4" ? "active" : "")">4</a>
            <div class="step-line"></div>

            <!-- الخطوة 5 -->
            <a href="@Url.Action("housing_form_step5", "Home")" class="step-circle text-decoration-none @(ViewContext.RouteData.Values["action"]?.ToString() == "housing_form_step5" ? "active" : "")">5</a>
            <div class="step-line"></div>

            <!-- الخطوة 6 (الحالية) -->
            <a href="@Url.Action("housing_form_step6", "Home")" class="step-circle text-decoration-none @(ViewContext.RouteData.Values["action"]?.ToString() == "housing_form_step6" ? "active" : "")">6</a>
            <div class="step-line"></div>

            <!-- الخطوة 7 -->
            <a href="@Url.Action("housing_form_step7", "Home")" class="step-circle text-decoration-none @(ViewContext.RouteData.Values["action"]?.ToString() == "housing_form_step7" ? "active" : "")">7</a>
            <div class="step-line"></div>

            <!-- الخطوة 8 -->
            <a href="@Url.Action("housing_form_step8", "Home")" class="step-circle text-decoration-none @(ViewContext.RouteData.Values["action"]?.ToString() == "housing_form_step8" ? "active" : "")">8</a>
        </div>
    </div>

    <!-- نموذج إدخال بيانات الخطوة السادسة -->
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            <form>

                <h5 class="fw-bold mb-4 text-end">اختر الأمراض التي تنطبق عليك</h5>

                <div class="d-flex flex-column gap-3 mb-5">
                    <!-- ارتفاع ضغط الدم -->
                    <div class="form-check d-flex align-items-center gap-2 ps-0">
                        <input class="form-check-input m-0" type="checkbox" id="disease1">
                        <label class="form-check-label" for="disease1">ارتفاع ضغط الدم</label>
                    </div>

                    <!-- الاضطراب النفسي -->
                    <div class="form-check d-flex align-items-center gap-2 ps-0">
                        <input class="form-check-input m-0" type="checkbox" id="disease2">
                        <label class="form-check-label" for="disease2">الاضطراب النفسي</label>
                    </div>

                    <!-- الأمراض القلبية -->
                    <div class="form-check d-flex align-items-center gap-2 ps-0">
                        <input class="form-check-input m-0" type="checkbox" id="disease3">
                        <label class="form-check-label" for="disease3">الأمراض القلبية</label>
                    </div>

                    <!-- الصرع -->
                    <div class="form-check d-flex align-items-center gap-2 ps-0">
                        <input class="form-check-input m-0" type="checkbox" id="disease4">
                        <label class="form-check-label" for="disease4">الصرع</label>
                    </div>

                    <!-- السكري -->
                    <div class="form-check d-flex align-items-center gap-2 ps-0">
                        <input class="form-check-input m-0" type="checkbox" id="disease5">
                        <label class="form-check-label" for="disease5">السكري</label>
                    </div>

                    <!-- الربو -->
                    <div class="form-check d-flex align-items-center gap-2 ps-0">
                        <input class="form-check-input m-0" type="checkbox" id="disease6">
                        <label class="form-check-label" for="disease6">الربو</label>
                    </div>

                    <!-- السرطان -->
                    <div class="form-check d-flex align-items-center gap-2 ps-0">
                        <input class="form-check-input m-0" type="checkbox" id="disease7">
                        <label class="form-check-label" for="disease7">السرطان</label>
                    </div>
                </div>

                <!-- أزرار السابق والتالي (تم عكسها لتناسب الاتجاه العربي: السابق على اليسار والتالي على اليمين أو حسب الرغبة) -->
                <div class="d-flex justify-content-between">
                    <a href="@Url.Action("housing_form_step5", "Home")" class="btn btn-secondary px-4 fw-semibold shadow-sm text-decoration-none">السابق</a>
                    <a href="@Url.Action("housing_form_step7", "Home")" class="btn btn-next text-white px-4 fw-semibold shadow-sm text-decoration-none">التالي</a>
                </div>

            </form>
        </div>
    </div>

</div>