@{
    ViewData["Title"] = "سياسة الخصوصية";
    // ربط الهيدر والفوتر الكحلي الموحد مباشرة
    Layout = "_HeaderAndFooter";
}

<div class="container my-5" style="max-width: 900px; direction: rtl; text-align: right;">
    <div class="card shadow-sm border-0 p-4 p-md-5 rounded-4 bg-white">

        <!-- عنوان الصفحة -->
        <h3 class="fw-bold text-custom-blue mb-4 pb-2 border-bottom">
            سياسة الخصوصية - سكنات الجامعة الأردنية
        </h3>

        <p class="text-secondary mb-4 fs-6">
            نحن نحترم خصوصيتك، وملتزمون بحماية بياناتك الشخصية عند استخدامك لتطبيق سكنات الجامعة الأردنية.
        </p>

        <!-- النقاط التوضيحية -->
        <ul class="list-unstyled d-flex flex-column gap-3 fs-6 text-dark">
            <li class="d-flex align-items-start gap-2">
                <span class="text-custom-blue fs-5 lh-1">•</span>
                <span>قد نطلب بيانات محدودة مثل الايميل الجامعي ورقم الطالب فقط لتسهيل الطلبات وتأكيد الهويات.</span>
            </li>
            <li class="d-flex align-items-start gap-2">
                <span class="text-custom-blue fs-5 lh-1">•</span>
                <span>لا نقوم بجمع أي معلومات شخصية حساسة دون علمك أو موافقتك.</span>
            </li>
            <li class="d-flex align-items-start gap-2">
                <span class="text-custom-blue fs-5 lh-1">•</span>
                <span>باستخدامك للتطبيق، فإنك توافق على سياسة الخصوصية هذه.</span>
            </li>
            <li class="d-flex align-items-start gap-2">
                <span class="text-custom-blue fs-5 lh-1">•</span>
                <span>لا تتم مشاركة بياناتك مع أي طرف ثالث.</span>
            </li>
            <li class="d-flex align-items-start gap-2">
                <span class="text-custom-blue fs-5 lh-1">•</span>
                <span>جميع البيانات يتم تخزينها بشكل آمن، وتُستخدم فقط لتحسين تجربة المستخدم داخل التطبيق.</span>
            </li>
        </ul>

    </div>
</div>